// MiniCAD 界面描述（MiniCADWin，界面由 MiniGUI 绘制）
// 程序运行时修改并保存本文件，界面立即更新（也可按 F5）；写错时保留当前界面，状态栏显示错误位置。
// - commands：覆盖命令的名称 label、快捷键 shortcut、图标 icon（相对 icons 目录）、提示 tooltip
// - menus / toolbars 的项是命令 ID，"-" 或 "|" 为分隔线
//   菜单项也可写成 { "title": "…", "items": [ … ] } 子菜单，或 { "title": "…", "dynamic": "recent" }
//   由程序在打开菜单时生成内容（"recent" = 最近打开；列表为空时该项置灰）
// - layout：titlebar / row / column / menubar / toolbar / panel / splitter / separator / spacer / label / dock
//   titlebar：无边框窗口的标题栏，children 放在图标右边（菜单栏），右侧按钮执行 window.minimize / window.maximize / window.close
//   宿主提供的面板：documents（文档标签 + 视口）、commandline（命令行）、properties（特性）、layers（图层）、
//   layerbar（图层 / 线型 / 线宽下拉框）、statusbar（状态栏）、nodes（节点编辑器，默认不在布局里，"视图 > 面板 > 节点编辑器"打开）
// - dock：停靠区，root 为布局树（split: row / column，tabs: 面板列表，size: 尺寸）。
//   用户拖动后的布局保存在 %LOCALAPPDATA%\MiniCAD\layout.json，启动时优先使用；"视图 > 面板 > 重置面板布局"恢复这里的默认布局
{
  "commands": {
    "draw.line": { "tooltip": "指定两点绘制直线段，Esc 结束" },
    "draw.circle": { "tooltip": "指定圆心和半径" },
    "solid.box": { "tooltip": "三维长方体：指定底面两个角点和高度" },
    "solid.cylinder": { "tooltip": "三维圆柱体：指定底面中心、半径和高度" },
    "solid.sphere": { "tooltip": "三维球体：指定中心和半径" },
    "solid.extrude": { "tooltip": "先选择闭合的圆、多段线或矩形，再指定高度，拉伸为三维实体" },
    "view.top": { "tooltip": "俯视（平面视图）：二维绘图的默认视图；三维视图里按住 Shift 拖动中键环绕" },
    "view.swiso": { "tooltip": "西南等轴测：从左前上方看；按住 Shift 拖动中键可继续环绕" },
    "view.style.shaded": { "tooltip": "画出三维实体的面，三维视图里被挡住的边不显示" },
    "view.style.wireframe": { "tooltip": "只画边（线框）" },
    "view.viewcube": { "tooltip": "绘图区左上角的视图方块：点面、棱、角切换视图，拖动环绕" },
    "solid.revolve": { "tooltip": "先选择闭合的圆、多段线或矩形，再指定旋转轴和角度，旋转为三维实体" },
    "solid.sweep": { "tooltip": "先选择闭合的圆、多段线或矩形，再选择路径（直线、圆弧、圆、多段线），沿路径扫掠为三维实体" },
    "solid.filletedge": { "tooltip": "点选三维实体的边倒圆角，键入数值改半径，回车完成（Tab 切换重叠的边）" },
    "solid.chamferedge": { "tooltip": "点选三维实体的边倒角，键入数值改距离，回车完成（Tab 切换重叠的边）" },
    "view.panel.nodes": { "tooltip": "节点式参数化建模：把几何运算连成节点图，改参数实时更新，点“烘焙”加入图纸（命令行 NODES）" },
    "solid.section": { "tooltip": "先选择三维实体：键入高度得到水平截面，或点取两点得到铅垂剖面图" },
    "solid.flatshot": { "tooltip": "先选择三维实体，按俯视、前视、右视等方向投影成二维图（含隐藏线）" },
    "region.union": { "tooltip": "合并选中的面域或三维实体" },
    "region.subtract": { "tooltip": "从最先创建的面域或三维实体中减去其余选中的对象" },
    "region.intersect": { "tooltip": "求选中的面域或三维实体的公共部分" }
  },

  "menus": [
    {
      "title": "文件(&F)",
      "items": [ "file.new", "file.open", "-", { "title": "最近打开(&R)", "dynamic": "recent" }, "-", "file.save", "file.saveAs", "file.saveAll", "-", "file.close", "-", "app.exit" ]
    },
    {
      "title": "编辑(&E)",
      "items": [ "edit.undo", "edit.redo", "-", "edit.cut", "edit.copy", "edit.copyBase", "edit.paste", "edit.delete", "-", "edit.selectAll" ]
    },
    {
      "title": "视图(&V)",
      "items": [
        "view.zoomExtents",
        "-",
        "view.grid",
        "view.axis",
        "view.gizmo",
        "view.viewcube",
        "view.thinLines",
        "-",
        {
          "title": "三维视图",
          "items": [ "view.top", "view.bottom", "view.left", "view.right", "view.front", "view.back", "-",
                     "view.swiso", "view.seiso", "view.neiso", "view.nwiso" ]
        },
        {
          "title": "视觉样式",
          "items": [ "view.style.wireframe", "view.style.shaded" ]
        },
        "-",
        {
          "title": "绘图辅助",
          "items": [ "aux.snap", "aux.ortho", "aux.polar", "aux.hover" ]
        },
        {
          "title": "面板",
          "items": [ "view.panel.properties", "view.panel.layers", "view.panel.commandline", "view.panel.nodes", "-", "view.resetLayout" ]
        },
        "-",
        "ui.theme",
        "ui.reload"
      ]
    },
    {
      "title": "格式(&O)",
      "items": [ "layer.new", "-", "format.textStyle", "format.mlineStyle", "format.pointStyle", "format.lineTypeScale" ]
    },
    {
      "title": "绘图(&D)",
      "items": [
        "draw.line",
        "draw.point",
        "draw.rect",
        "draw.circle",
        "draw.arc",
        "draw.ellipse",
        "draw.ellipseArc",
        "-",
        "draw.pline",
        "draw.mline",
        "draw.spline",        "-",
        "draw.xline",
        "draw.ray",
        "-",
        "draw.hatch",
        "draw.solid",
        "draw.wipeout",
        "draw.image",
        "-",
        {
          "title": "文字",
          "items": [ "draw.text", "draw.mtext" ]
        },
        "draw.table",
        "draw.region",
        {
          "title": "块",
          "items": [ "block.define", "block.insert" ]
        }
      ]
    },
    {
      "title": "查询(&Q)",
      "items": [ "inquiry.area" ]
    },
    {
      "title": "标注(&N)",
      "items": [ "dim.linear", "dim.angular", "-", "dim.radius", "dim.diameter", "dim.jogged", "dim.arc", "-", "dim.ordinate", "-", "dim.leader", "dim.mleader" ]
    },
    {
      "title": "修改(&M)",
      "items": [
        "modify.move",
        "modify.copy",
        "modify.mirror",
        "modify.rotate",
        "modify.scale",
        "modify.stretch",
        "modify.offset",
        "modify.fillet",
        "modify.chamfer",
        "modify.explode",
        "-",
        "modify.trim",
        "modify.extend",
        "modify.break",
        "-",
        "modify.mledit",
        "-",
        "modify.array",
        "-",
        {
          "title": "面域",
          "items": [ "region.union", "region.subtract", "region.intersect" ]
        }
      ]
    },
    {
      "title": "建模(&L)",
      "items": [ "solid.box", "solid.cylinder", "solid.sphere", "-", "solid.extrude", "solid.revolve", "solid.sweep", "-", "region.union", "region.subtract", "region.intersect", "-", "solid.filletedge", "solid.chamferedge", "-", "solid.section", "solid.flatshot", "-", "view.panel.nodes", "nodes.bake" ]
    },
    {
      "title": "窗口(&W)",
      "items": [ "doc.next", "doc.prev", "-", "file.close" ]
    },
    {
      "title": "帮助(&H)",
      "items": [ "help.about" ]
    }
  ],

  "toolbars": {
    "standard": [ "file.new", "file.open", "file.save", "|", "edit.undo", "edit.redo"],
    "draw": {
      "items": [ "draw.line", "draw.circle", "draw.rect", "draw.arc", "draw.ellipse", "draw.pline", "draw.mline", "draw.spline", "draw.text", "draw.mtext" ],
      "iconSize": 20
    },
    "modify": [ "modify.move", "modify.copy", "modify.mirror", "modify.rotate" ]
  },

  "layout": {
    "type": "column",
    "children": [
      {
        "type": "titlebar",
        "icon": "app.png",
        "shrink": 0,
        "children": [ { "type": "menubar" } ]
      },
      {
        "type": "row",
        "background": "Panel",
        "shrink": 0,
        "align": "center",
        "children": [
          {
            "type": "toolbar",
            "id": "standard"
          },
          {
            "type": "separator",
            "height": 20
          },
          {
            "type": "toolbar",
            "id": "draw"
          },
          {
            "type": "separator",
            "height": 20
          },
          {
            "type": "toolbar",
            "id": "modify",
            "shrink": 1
          },
          {
            "type": "separator",
            "height": 20
          },
          {
            "type": "panel",
            "name": "layerbar"
          },
          { "type": "spacer" }
        ]
      },
      { "type": "separator", "shrink": 0 },
      // 停靠区：文档区（没有标题栏）下面是命令行，右侧上下排列特性和图层；拖动面板标签可以停靠到其他位置或合并为标签
      {
        "type": "dock",
        "id": "main",
        "panels": [ "nodes" ],
        "grow": 1,
        "root": {
          "split": "row",
          "children": [
            {
              "split": "column",
              "children": [
                {
                  "tabs": [
                    {
                      "panel": "documents",
                      "header": false,
                      "closable": false
                    }
                  ]
                },
                {
                  "tabs": [ "commandline" ],
                  "size": 140
                }
              ]
            },
            {
              "split": "column",
              "size": 350,
              "children": [
                { "tabs": [ "properties" ] },
                {
                  "tabs": [ "layers" ],
                  "size": 280
                }
              ]
            }
          ]
        }
      },
      {
        "type": "panel",
        "name": "statusbar",
        "shrink": 0
      }
    ]
  }
}
