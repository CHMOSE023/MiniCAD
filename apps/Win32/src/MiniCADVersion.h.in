// 由 CMake 从 apps/Win32/src/MiniCADVersion.h.in 生成，不要手改。版本号来自根 CMakeLists.txt 的 MINICAD_VERSION。
#define MINICAD_VERSION_MAJOR @MINICAD_VERSION_MAJOR@
#define MINICAD_VERSION_MINOR @MINICAD_VERSION_MINOR@
#define MINICAD_VERSION_PATCH @MINICAD_VERSION_PATCH@
#define MINICAD_VERSION_STRING "@MINICAD_VERSION@"

// 资源文件（MiniCAD.rc）用的字符串，末尾的 \0 是 VERSIONINFO 字符串要求的结束符
#define MINICAD_FILE_VERSION_STR "@MINICAD_VERSION@.0\0"
#define MINICAD_PRODUCT_VERSION_STR "@MINICAD_VERSION@\0"
