<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 检查更新（GitHub Release） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="MiniCAD"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasCode="true"
        android:theme="@style/Theme.MiniCAD"
        android:enableOnBackInvokedCallback="true">

        <!-- 旋转、接上键盘、改字号都当成改尺寸自己处理，不重建 Activity（原生状态不丢） -->
        <activity
            android:name=".MiniCADActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="MiniCADAndroid" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
